    "# Sinple Intrest Calculator"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "319783d7-a452-460a-86fb-7edb0686e807",
   "metadata": {},
   "outputs": [],
   "source": [
    "p = float(input(\"Principal (Rs) :\"))\n",
    "r = float(input(\"Rate (% per year) :\"))\n",
    "t = float(input(\"Time (years) :\"))\n",
    "\n",
    "si = (p * r * t) / 100\n",
    "amount = p + si\n",
    "\n",
    "print(f\"Simple Intrest : Rs {si}\")\n",
    "print(f\"Total amount : Rs {amount}\")"
   ]
  }
